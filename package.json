{
  "name": "mishrashardendu22",
  "version": "3.1.0",
  "private": true,
  "description": "Monorepo for Shardendu Mishra's portfolio ecosystem - Blog platform, and admin dashboard.",
  "author": {
    "name": "Shardendu Mishra",
    "email": "mishrashardendu22@gmail.com",
    "url": "https://github.com/MishraShardendu22"
  },
  "homepage": "https://github.com/MishraShardendu22/MishraShardendu",
  "repository": {
    "type": "git",
    "url": "https://github.com/MishraShardendu22/MishraShardendu.git"
  },
  "bugs": {
    "url": "https://github.com/MishraShardendu22/MishraShardendu/issues"
  },
  "license": "MIT",
  "keywords": [
    "monorepo",
    "portfolio",
    "turborepo",
    "pnpm",
    "nextjs",
    "svelte",
    "vite",
    "typescript",
    "react",
    "preact"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "clean:turbo": "rm -rf .turbo apps/*/.turbo packages/*/.turbo",
    "clean:all": "pnpm clean && pnpm clean:turbo",
    "reset": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/package-lock.json packages/*/package-lock.json pnpm-lock.yaml && pnpm install",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "1.61.0",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "0.28.1",
    "husky": "^9.1.7",
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
